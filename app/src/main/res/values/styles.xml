<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme de l'activite de lancement (splash), fond sombre = background_color de la PWA.
         Theme.Material (API 21+) : pas besoin d'AppCompat, l'activite est transitoire. -->
    <style name="Theme.LeekWars" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Duree du fondu de sortie du splash (ms). -->
    <integer name="splashScreenFadeOutDuration">300</integer>
</resources>